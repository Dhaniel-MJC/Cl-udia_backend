# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser commitado nem compartilhado.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://seu-projeto.supabase.co

# Supabase > Project Settings > API
# Chave usada SOMENTE neste servidor. Se for a service_role, ela ignora o RLS:
# jamais coloque essa chave no app Next.js do lado do navegador.
SUPABASE_KEY=sua-chave-aqui

# Porta do servidor (opcional; padrao 3000)
PORT=3000
